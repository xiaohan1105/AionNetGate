<Page
    x:Class="AionNetGate.Admin.WPF.Views.Pages.LauncherConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:LauncherConfigViewModel}"
    Title="登录器配置">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- 基本信息 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="基本信息" Icon="{ui:SymbolIcon Info24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="登录器名称" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding LauncherName}" PlaceholderText="Aion Online" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="LS 端口" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding LsPort}" Minimum="1" Maximum="65535" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="BIN32 路径" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Bin32Path}" PlaceholderText="bin32/aion.bin" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16">
                            <TextBlock Text="BIN64 路径" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Bin64Path}" PlaceholderText="bin64/aion.bin" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,16">
                            <TextBlock Text="启动参数" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding LaunchArgs}" PlaceholderText="-cc:5 -lang:chs" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0">
                            <TextBlock Text="WEB URL" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding WebUrl}" PlaceholderText="http://your-server.com" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 补丁配置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="补丁配置" Icon="{ui:SymbolIcon ArrowDownload24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="补丁 URL" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding PatchUrl}" PlaceholderText="http://your-server.com/patch" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="更新 URL" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding UpdateUrl}" PlaceholderText="http://your-server.com/update" />
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="登录器 MD5" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding LauncherMd5}" IsReadOnly="True" />
                                <ui:Button
                                    Grid.Column="1"
                                    Content="生成 MD5"
                                    Icon="{ui:SymbolIcon Key24}"
                                    Command="{Binding GenerateMd5Command}"
                                    Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 安全配置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="安全配置" Icon="{ui:SymbolIcon Shield24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="目录限制 (每行一个目录)" Margin="0,0,0,4" />
                            <ui:TextBox
                                Text="{Binding ClientFilesRestriction}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="文件 MD5 列表 (每行一个)" Margin="0,0,0,4" />
                            <ui:TextBox
                                Text="{Binding FileMd5List}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,16">
                            <TextBlock Text="外挂进程列表 (每行一个)" Margin="0,0,0,4" />
                            <ui:TextBox
                                Text="{Binding CheatProcessList}"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="80" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <CheckBox Content="发现外挂自动关闭" IsChecked="{Binding AutoCloseOnCheatDetected}" />
                            <CheckBox Content="允许多开" IsChecked="{Binding AllowMultipleInstances}" Margin="24,0,0,0" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 输出配置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="输出配置" Icon="{ui:SymbolIcon FolderOpen24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="皮肤目录" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding SkinPath}" IsReadOnly="True" />
                                <ui:Button
                                    Grid.Column="1"
                                    Content="浏览..."
                                    Command="{Binding SelectSkinPathCommand}"
                                    Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="输出目录" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" Text="{Binding OutputDirectory}" IsReadOnly="True" />
                                <ui:Button
                                    Grid.Column="1"
                                    Content="浏览..."
                                    Command="{Binding SelectOutputDirectoryCommand}"
                                    Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="输出文件名" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding OutputFileName}" PlaceholderText="AionLauncher" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 操作按钮 -->
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button
                            Content="生成登录器"
                            Icon="{ui:SymbolIcon Wrench24}"
                            Appearance="Primary"
                            Command="{Binding BuildLauncherCommand}"
                            IsEnabled="{Binding IsBuilding, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Content="恢复默认"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            Command="{Binding ResetToDefaultsCommand}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Content="保存配置"
                            Icon="{ui:SymbolIcon Save24}"
                            Command="{Binding SaveConfigCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            IsIndeterminate="True"
                            Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                        <TextBlock Text="{Binding BuildStatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
