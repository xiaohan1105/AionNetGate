<Page
    x:Class="AionNetGate.Admin.WPF.Views.Pages.DatabaseConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:DatabaseConfigViewModel}"
    Title="数据库配置">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="800" HorizontalAlignment="Left">
            <!-- 数据库类型 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="数据库类型" Icon="{ui:SymbolIcon Database24}" IsExpanded="True">
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <RadioButton Content="MySQL" IsChecked="{Binding IsMySql}" Margin="0,0,24,0">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                    <Setter Property="Padding" Value="8,4" />
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                        <RadioButton Content="SQL Server" IsChecked="{Binding IsMsSql}">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                                    <Setter Property="Padding" Value="8,4" />
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                    </StackPanel>
                </ui:CardExpander>
            </ui:Card>

            <!-- 连接设置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="连接设置" Icon="{ui:SymbolIcon PlugConnected24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="服务器地址" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding ServerAddress}" PlaceholderText="localhost" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,16" Width="120">
                            <TextBlock Text="端口" Margin="0,0,0,4" />
                            <ui:NumberBox Value="{Binding ServerPort}" Minimum="1" Maximum="65535" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,16">
                            <TextBlock Text="用户名" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Username}" PlaceholderText="root" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,16" Width="120">
                            <TextBlock Text="字符集" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Charset}" PlaceholderText="utf8mb4" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="密码" Margin="0,0,0,4" />
                            <ui:PasswordBox Password="{Binding Password}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 数据库名称 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="数据库名称" Icon="{ui:SymbolIcon TableSimple24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="账号数据库" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding AccountDatabase}" PlaceholderText="aion_ls" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="游戏数据库" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding GameDatabase}" PlaceholderText="aion_gs" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 高级设置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="高级设置" Icon="{ui:SymbolIcon Settings24}" IsExpanded="False">
                    <StackPanel Margin="0,16,0,0">
                        <CheckBox Content="启用连接池" IsChecked="{Binding EnableConnectionPooling}" Margin="0,0,0,8" />
                        <CheckBox Content="启用数据库日志" IsChecked="{Binding EnableDatabaseLogging}" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="连接超时" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:NumberBox Value="{Binding ConnectionTimeout}" Width="100" Minimum="1" Maximum="300" />
                            <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardExpander>
            </ui:Card>

            <!-- 操作按钮 -->
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:Button
                            Content="测试连接"
                            Icon="{ui:SymbolIcon PlugConnected24}"
                            Appearance="Primary"
                            Command="{Binding TestConnectionCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,8,0" />
                        <ui:Button
                            Content="保存配置"
                            Icon="{ui:SymbolIcon Save24}"
                            Command="{Binding SaveConfigCommand}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            IsIndeterminate="True"
                            Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                        <ui:SymbolIcon
                            Symbol="CheckmarkCircle24"
                            Foreground="LimeGreen"
                            Visibility="{Binding TestSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
