{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Database": {
    "Provider": "SQLite",
    "ConnectionString": "Data Source=aionnetgate.db"
  },
  "Security": {
    "JwtSecretKey": "Your-256-bit-Secret-Key-Here-Change-This-In-Production-Environment-32Chars",
    "JwtIssuer": "AionNetGate",
    "JwtAudience": "AionClients",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7,
    "MaxLoginAttempts": 5,
    "AccountLockoutMinutes": 30
  },
  "Server": {
    "BindAddress": "0.0.0.0",
    "Port": 10001,
    "MaxConnections": 10000,
    "ReceiveBufferSize": 8192,
    "SendBufferSize": 8192
  }
}
