{
  "Urls": "http://localhost:5100",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "webapi-route": {
        "ClusterId": "webapi-cluster",
        "RateLimiterPolicy": "api",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeader": "X-Forwarded-Gateway", "Set": "AionNetGate" }
        ]
      },
      "auth-route": {
        "ClusterId": "webapi-cluster",
        "RateLimiterPolicy": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api" }
        ]
      },
      "health-route": {
        "ClusterId": "webapi-cluster",
        "RateLimiterPolicy": "monitoring",
        "Match": {
          "Path": "/api/health/{**catch-all}"
        }
      },
      "metrics-route": {
        "ClusterId": "webapi-cluster",
        "RateLimiterPolicy": "monitoring",
        "Match": {
          "Path": "/metrics"
        }
      }
    },
    "Clusters": {
      "webapi-cluster": {
        "Destinations": {
          "webapi-primary": {
            "Address": "http://localhost:5000"
          }
        },
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:01:00"
          }
        },
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": false,
          "RequestHeaderEncoding": "utf-8"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  }
}
