<UserControl x:Class="AionNetGate.Admin.WPF.Views.ClientListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
             xmlns:converters="clr-namespace:AionNetGate.Admin.WPF.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ClientListViewModel}"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:ConnectionTimeConverter x:Key="ConnectionTimeConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- DataGrid 样式 -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#3F3F46"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E42"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="刷新列表"
                            Command="{Binding RefreshCommand}"
                            MinWidth="80" Padding="10,5" Margin="0,0,10,0"/>
                    <Button Content="断开连接"
                            Command="{Binding DisconnectClientCommand}"
                            MinWidth="80" Padding="10,5"
                            IsEnabled="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 搜索框 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,0">
                    <TextBlock Text="搜索:"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="200" Padding="5"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 统计信息 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding TotalClients, StringFormat='总计: {0} 个客户端'}"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="14"/>
            </Grid>
        </Border>

        <!-- 客户端列表 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Clients}"
                  SelectedItem="{Binding SelectedClient}"
                  Margin="0">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看远程桌面" Command="{Binding ViewRemoteDesktopCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="🖥️" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="查看进程列表" Command="{Binding ViewProcessesCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⚙️" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="浏览文件系统" Command="{Binding ViewFilesCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📁" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="断开连接" Command="{Binding DisconnectClientCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="❌" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- 状态指示器 -->
                <DataGridTemplateColumn Header="状态" Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12"
                                     Fill="{Binding IsOnline, Converter={StaticResource BoolToColorConverter}}"
                                     HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 连接 ID -->
                <DataGridTextColumn Header="连接 ID" Binding="{Binding ConnectionId}" Width="120"/>

                <!-- 账号名 -->
                <DataGridTextColumn Header="账号名" Binding="{Binding Username}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#00D7FF"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 硬件 ID -->
                <DataGridTextColumn Header="硬件 ID" Binding="{Binding HardwareId}" Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="Foreground" Value="#D4D4D4"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- IP 地址 -->
                <DataGridTextColumn Header="IP 地址" Binding="{Binding RemoteAddress}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 连接时长 -->
                <DataGridTemplateColumn Header="连接时长" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ConnectedAt, Converter={StaticResource ConnectionTimeConverter}}"
                                       Foreground="#CE9178"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 客户端版本 -->
                <DataGridTextColumn Header="版本" Binding="{Binding ClientVersion}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 操作系统 -->
                <DataGridTextColumn Header="操作系统" Binding="{Binding OsInfo}" Width="*" MinWidth="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 详情面板（当选中客户端时显示） -->
        <Border Grid.Row="2"
                Background="#2D2D30"
                Padding="15"
                BorderBrush="#3F3F46"
                BorderThickness="0,1,0,0"
                Visibility="{Binding SelectedClient, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 客户端详细信息 -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="客户端详细信息"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="5"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="连接 ID:" Foreground="#9CDCFE"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="{Binding SelectedClient.ConnectionId}"
                                   Foreground="White"
                                   FontFamily="Consolas"/>

                        <TextBlock Grid.Row="0" Grid.Column="4" Text="账号 ID:" Foreground="#9CDCFE"/>
                        <TextBlock Grid.Row="0" Grid.Column="6"
                                   Text="{Binding SelectedClient.AccountId}"
                                   Foreground="White"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="连接时间:" Foreground="#9CDCFE"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="{Binding SelectedClient.ConnectedAt, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                   Foreground="White"
                                   FontFamily="Consolas"/>

                        <TextBlock Grid.Row="2" Grid.Column="4" Text="硬件 ID:" Foreground="#9CDCFE"/>
                        <TextBlock Grid.Row="2" Grid.Column="6"
                                   Text="{Binding SelectedClient.HardwareId}"
                                   Foreground="White"
                                   FontFamily="Consolas"/>
                    </Grid>
                </StackPanel>

                <!-- 快捷操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="远程桌面"
                            Command="{Binding ViewRemoteDesktopCommand}"
                            Padding="15,8" Margin="5,0"/>
                    <Button Content="进程管理"
                            Command="{Binding ViewProcessesCommand}"
                            Padding="15,8" Margin="5,0"/>
                    <Button Content="文件浏览"
                            Command="{Binding ViewFilesCommand}"
                            Padding="15,8" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
