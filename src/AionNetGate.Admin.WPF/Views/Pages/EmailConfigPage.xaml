<Page
    x:Class="AionNetGate.Admin.WPF.Views.Pages.EmailConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:EmailConfigViewModel}"
    Title="邮件通知">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" MaxWidth="600" HorizontalAlignment="Left">
            <!-- SMTP 配置 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="SMTP 配置" Icon="{ui:SymbolIcon Mail24}" IsExpanded="True">
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="发送邮箱" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding SenderEmail}" PlaceholderText="your-email@example.com" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="邮箱密码/授权码" Margin="0,0,0,4" />
                            <ui:PasswordBox Password="{Binding EmailPassword}" PlaceholderText="授权码" />
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="SMTP 服务器" Margin="0,0,0,4" />
                                <ui:TextBox Text="{Binding SmtpServer}" PlaceholderText="smtp.qq.com" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Width="100">
                                <TextBlock Text="端口" Margin="0,0,0,4" />
                                <ui:NumberBox Value="{Binding SmtpPort}" Minimum="1" Maximum="65535" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="3">
                            <CheckBox Content="启用 SSL/TLS" IsChecked="{Binding EnableSsl}" />
                        </StackPanel>
                    </Grid>
                </ui:CardExpander>
            </ui:Card>

            <!-- 测试发送 -->
            <ui:Card Margin="0,0,0,16">
                <ui:CardExpander Header="测试发送" Icon="{ui:SymbolIcon Send24}" IsExpanded="True">
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="测试收件人" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding TestRecipient}" PlaceholderText="test@example.com" Margin="0,0,0,16" />

                        <ui:Button
                            Content="发送测试邮件"
                            Icon="{ui:SymbolIcon Send24}"
                            Appearance="Primary"
                            Command="{Binding SendTestEmailCommand}"
                            IsEnabled="{Binding IsSending, Converter={StaticResource InverseBoolConverter}}" />
                    </StackPanel>
                </ui:CardExpander>
            </ui:Card>

            <!-- 操作按钮 -->
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:Button
                        Grid.Column="0"
                        Content="保存配置"
                        Icon="{ui:SymbolIcon Save24}"
                        Appearance="Primary"
                        Command="{Binding SaveConfigCommand}"
                        HorizontalAlignment="Left" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:ProgressRing
                            Width="24"
                            Height="24"
                            IsIndeterminate="True"
                            Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                        <ui:SymbolIcon
                            Symbol="CheckmarkCircle24"
                            Foreground="LimeGreen"
                            Visibility="{Binding SendSuccess, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
