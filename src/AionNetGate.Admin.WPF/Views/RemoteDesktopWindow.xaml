<Window x:Class="AionNetGate.Admin.WPF.Views.RemoteDesktopWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
        xmlns:converters="clr-namespace:AionNetGate.Admin.WPF.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RemoteDesktopViewModel}"
        Title="{Binding ClientInfo, StringFormat='远程桌面 - {0}'}"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧控制按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="刷新"
                            Command="{Binding RefreshCommand}"
                            MinWidth="80" Padding="10,5" Margin="0,0,10,0"/>

                    <ToggleButton Content="自动刷新"
                                  IsChecked="{Binding AutoRefresh}"
                                  MinWidth="80" Padding="10,5" Margin="0,0,10,0"/>

                    <TextBlock Text="刷新间隔:"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Margin="10,0,5,0"/>

                    <ComboBox SelectedValue="{Binding RefreshInterval}"
                              MinWidth="100" Padding="5"
                              VerticalAlignment="Center">
                        <ComboBoxItem Content="500ms" Tag="500"/>
                        <ComboBoxItem Content="1秒" Tag="1000" IsSelected="True"/>
                        <ComboBoxItem Content="2秒" Tag="2000"/>
                        <ComboBoxItem Content="5秒" Tag="5000"/>
                    </ComboBox>
                </StackPanel>

                <!-- 状态文本 -->
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Foreground="#9CDCFE"
                           FontSize="12"/>
            </Grid>
        </Border>

        <!-- 桌面图像显示区 -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#3F3F46" BorderThickness="1">
            <Grid>
                <!-- 加载指示器 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding DesktopImage, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="📺" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                    <TextBlock Text="等待屏幕截图..."
                               FontSize="16"
                               Foreground="Gray"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 桌面截图 -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Image Source="{Binding DesktopImage}"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </ScrollViewer>

                <!-- 刷新中遮罩 -->
                <Border Background="#80000000"
                        Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="正在获取屏幕截图..."
                                   FontSize="14"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2" Background="#007ACC" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ConnectionId, StringFormat='连接 ID: {0}'}"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding LastUpdateTime, StringFormat='最后更新: {0:yyyy-MM-dd HH:mm:ss}'}"
                           Foreground="White"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
