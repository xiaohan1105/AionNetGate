# AionNetGate 环境变量配置示例
# 复制此文件为 .env 并修改为实际值

# MySQL 配置
MYSQL_ROOT_PASSWORD=YourStrongRootPassword123!

# 加密密钥 (32字节 Base64 编码)
# 生成方法: openssl rand -base64 32
ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY_HERE

# JWT 密钥 (至少256位)
# 生成方法: openssl rand -base64 64
JWT_SECRET=YOUR_STRONG_JWT_SECRET_KEY_AT_LEAST_256_BITS

# Grafana 管理员密码
GRAFANA_PASSWORD=YourGrafanaPassword123!
