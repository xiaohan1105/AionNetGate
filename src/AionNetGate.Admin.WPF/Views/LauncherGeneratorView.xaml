<UserControl x:Class="AionNetGate.Admin.WPF.Views.LauncherGeneratorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:LauncherGeneratorViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="启动器生成器"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" />

        <!-- 配置表单 -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基本信息 -->
                <GroupBox Header="基本信息"
                          Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="渠道代码:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding ChannelCode}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="游戏标题:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding GameTitle}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="服务器名称:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ServerName}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="版本号:"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding Version}" />
                    </Grid>
                </GroupBox>

                <!-- 网关配置 -->
                <GroupBox Header="网关配置"
                          Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="网关地址:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding GatewayHost}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="网关端口:"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding GatewayPort}" />
                    </Grid>
                </GroupBox>

                <!-- 游戏配置 -->
                <GroupBox Header="游戏配置"
                          Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="游戏路径:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding GameExecutablePath}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="启动参数:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding GameCommandLineArgs}"
                                 Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="LS端口:"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding LsPort}" />
                    </Grid>
                </GroupBox>

                <!-- 皮肤和输出 -->
                <GroupBox Header="皮肤和输出"
                          Margin="0,0,0,15">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="皮肤路径:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding SkinPath}"
                                 Margin="0,0,5,10" />
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Content="浏览..."
                                Command="{Binding SelectSkinPathCommand}"
                                Width="80"
                                Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="输出目录:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,10" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding OutputDirectory}"
                                 Margin="0,0,5,10" />
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Content="浏览..."
                                Command="{Binding SelectOutputDirectoryCommand}"
                                Width="80"
                                Margin="0,0,0,10" />

                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="输出文件名:"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding OutputFileName}"
                                 Grid.ColumnSpan="2" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 构建控制和进度 -->
        <Grid Grid.Row="2"
              Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 进度条 -->
            <ProgressBar Grid.Row="0"
                         Height="25"
                         Value="{Binding BuildProgress}"
                         Minimum="0"
                         Maximum="100"
                         Margin="0,0,0,10" />

            <!-- 状态文本 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding BuildStatusText}"
                       FontSize="12"
                       Foreground="#666"
                       Margin="0,0,0,15" />

            <!-- 构建按钮 -->
            <Button Grid.Row="2"
                    Content="生成启动器"
                    Command="{Binding BuildLauncherCommand}"
                    IsEnabled="{Binding IsBuilding, Converter={StaticResource InverseBoolConverter}}"
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#0078D4"
                    Foreground="White"
                    BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#1084D8" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#CCC" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>
