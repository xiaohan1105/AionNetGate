<Window x:Class="AionNetGate.Admin.WPF.Views.FileBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
        xmlns:converters="clr-namespace:AionNetGate.Admin.WPF.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FileBrowserViewModel}"
        Title="{Binding ClientInfo, StringFormat='文件浏览器 - {0}'}"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BytesToMBConverter x:Key="BytesToMBConverter"/>
        <converters:FileIconConverter x:Key="FileIconConverter"/>
        <converters:FileSizeConverter x:Key="FileSizeConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="10" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 操作按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="刷新"
                            Command="{Binding LoadFilesCommand}"
                            MinWidth="70" Padding="10,5" Margin="0,0,5,0"/>

                    <Button Content="下载"
                            Command="{Binding DownloadFileCommand}"
                            MinWidth="70" Padding="10,5" Margin="0,0,5,0"
                            IsEnabled="{Binding SelectedFile, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <Button Content="删除"
                            Command="{Binding DeleteFileCommand}"
                            MinWidth="70" Padding="10,5"
                            IsEnabled="{Binding SelectedFile, Converter={StaticResource NullToVisibilityConverter}}"
                            Foreground="Red"/>
                </StackPanel>

                <!-- 快速导航 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="C:\" Command="{Binding GoToPathCommand}" CommandParameter="C:\" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="桌面" Command="{Binding GoToPathCommand}" CommandParameter="C:\Users\Public\Desktop" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="文档" Command="{Binding GoToPathCommand}" CommandParameter="C:\Users\Public\Documents" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 地址栏 -->
        <Border Grid.Row="1" Background="#2D2D30" Padding="10,5" BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="路径:" VerticalAlignment="Center" Foreground="White" Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding CurrentPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Padding="5"
                         FontFamily="Consolas"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
                    <TextBlock Text="搜索:" VerticalAlignment="Center" Foreground="White" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             MinWidth="150" Padding="5" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 文件列表 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Files}"
                  SelectedItem="{Binding SelectedFile}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  Background="#1E1E1E"
                  Foreground="White"
                  BorderBrush="#3F3F46"
                  HorizontalGridLinesBrush="#3F3F46"
                  RowBackground="#1E1E1E"
                  AlternatingRowBackground="#252526"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开/进入" Command="{Binding NavigateCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="📂" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="下载" Command="{Binding DownloadFileCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="⬇️" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="删除" Command="{Binding DeleteFileCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="❌" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="刷新" Command="{Binding LoadFilesCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="🔄" FontSize="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <!-- 图标 -->
                <DataGridTemplateColumn Header="" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding IsDirectory, Converter={StaticResource FileIconConverter}}"
                                       FontSize="20"
                                       HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 文件名 -->
                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="200">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="#00D7FF"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- 文件大小 -->
                <DataGridTemplateColumn Header="大小" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Right" Foreground="#CE9178">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 修改时间 -->
                <DataGridTextColumn Header="修改时间" Binding="{Binding LastModified, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="Foreground" Value="#9CDCFE"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#007ACC" Padding="5">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="White"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
