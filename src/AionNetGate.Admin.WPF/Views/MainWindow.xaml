<ui:FluentWindow
    x:Class="AionNetGate.Admin.WPF.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:AionNetGate.Admin.WPF.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Title="{Binding ApplicationTitle}"
    Width="1400"
    Height="900"
    MinWidth="1200"
    MinHeight="700"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <ui:TitleBar
            Grid.Row="0"
            Title="{Binding ApplicationTitle}"
            ShowMaximize="True"
            ShowMinimize="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                    <!-- 服务器状态指示器 -->
                    <Border
                        Width="12"
                        Height="12"
                        CornerRadius="6"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{Binding IsServerRunning, Converter={StaticResource BoolToColorConverter}}" />
                    <TextBlock
                        Text="{Binding ServerStatus}"
                        VerticalAlignment="Center"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        FontSize="12" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 服务器控制按钮 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button
                        Content="启动服务器"
                        Icon="{ui:SymbolIcon Play24}"
                        Appearance="Primary"
                        Command="{Binding StartServerCommand}"
                        IsEnabled="{Binding IsServerRunning, Converter={StaticResource InverseBoolConverter}}"
                        Margin="0,0,8,0" />
                    <ui:Button
                        Content="停止服务器"
                        Icon="{ui:SymbolIcon Stop24}"
                        Appearance="Danger"
                        Command="{Binding StopServerCommand}"
                        IsEnabled="{Binding IsServerRunning}" />
                </StackPanel>

                <!-- 状态信息 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Badge Appearance="Success" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="People24" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding OnlineClientsCount, StringFormat='在线: {0}'}" />
                        </StackPanel>
                    </ui:Badge>
                    <ui:Badge Appearance="Info" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowTrendingLines24" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding MaxOnlineClients, StringFormat='峰值: {0}'}" />
                        </StackPanel>
                    </ui:Badge>
                    <ui:Badge Appearance="Caution">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Timer24" Margin="0,0,4,0" />
                            <TextBlock Text="{Binding RunTime}" />
                        </StackPanel>
                    </ui:Badge>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 - TabControl -->
        <TabControl
            Grid.Row="2"
            SelectedIndex="{Binding SelectedTabIndex}"
            Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Padding" Value="16,8" />
                    <Setter Property="FontSize" Value="14" />
                </Style>
            </TabControl.Resources>

            <!-- Tab 1: 客户端管理 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="People24" Margin="0,0,8,0" />
                        <TextBlock Text="客户端管理" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="ClientsPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>

            <!-- Tab 2: 登录器配置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Apps24" Margin="0,0,8,0" />
                        <TextBlock Text="登录器配置" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="LauncherConfigPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>

            <!-- Tab 3: 服务器配置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Server24" Margin="0,0,8,0" />
                        <TextBlock Text="服务器配置" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="ServerConfigPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>

            <!-- Tab 4: 数据库配置 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Database24" Margin="0,0,8,0" />
                        <TextBlock Text="数据库配置" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="DatabaseConfigPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>

            <!-- Tab 5: 邮件通知 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Mail24" Margin="0,0,8,0" />
                        <TextBlock Text="邮件通知" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="EmailConfigPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>

            <!-- Tab 6: 军团统计 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DataBarVertical24" Margin="0,0,8,0" />
                        <TextBlock Text="军团统计" />
                    </StackPanel>
                </TabItem.Header>
                <Frame x:Name="LegionStatsPageHost" NavigationUIVisibility="Hidden" />
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <ui:InfoBar
            Grid.Row="3"
            Title="就绪"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Margin="0">
            <ui:InfoBar.Content>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding ApplicationVersion}"
                        VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock
                            Text="{Binding MemoryUsage, StringFormat='内存: {0}'}"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="{Binding CpuUsage, StringFormat='CPU: {0}'}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ui:InfoBar.Content>
        </ui:InfoBar>

        <!-- Snackbar 容器 -->
        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="2" />
    </Grid>
</ui:FluentWindow>
